\par \sect \sectd\marglsxn1080\margrsxn1080\margtsxn1440\margbsxn1440\sbknone\headery360\footery360\endnhere\pard\plain \fi360 \f1\cf1 
\par \pard\plain \s6\keepn\li720\sb360\sa360 \b\f1\fs48\cf1 {\fs28 Sample RFC-style Document}
\par \pard\plain \ri1440 \f1\cf1 {\f2\fs16  }{\f2\fs20           HTTP Authentication: Ticket Authentication}
\par 
\par {\f2\fs20 Table of Contents}
\par 
\par \pard\plain \li360\ri1440 \f1\cf1 {\f2\fs20 1   Introduction}
\par \pard\plain \li540\ri1440 \f1\cf1 {\f2\fs20 1.1   Goals}
