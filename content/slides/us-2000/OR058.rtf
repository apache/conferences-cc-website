\par
\f1 # Sample set of Apache Config Directives.\par
#\par
# - Sander van Zoest <sander@mp3.com>\par
#   MP3.com, Inc.\par
#\par
\par
## Static XML and templates\par
<IfModule mod_yasl.c>\par
  AddHandler\tab yasl-parse-html .html\par
  <Directory /usr/local/www/htdocs/apachecon/templates>\par
    Yasl On\par
  </Directory>\par
</IfModule>\par
\par
## Dynamic XML Generation using mod_perl\par
\par
<IfModule mod_perl.c>\par
  PerlFreshRestart On\par
  PerlRequire /usr/local/www/lib/ApacheCon/Example.pm\par
  PerlSetVar TemplateDir /apachecon/templates\par
  <Location /apachecon/perl>\par
    SetHandler perl-script\par
    PerlHandler ApacheCon::Example\par
    PerlSetVar RawXMLMode 0\par
  </Location>\par
  <Location /apachecon/perl/xml>\par
    SetHandler perl-script\par
    PerlHandler ApacheCon::Example\par
    PerlSetVar RawXMLMode 1\par
  </Location>\par
</IfModule>\par
